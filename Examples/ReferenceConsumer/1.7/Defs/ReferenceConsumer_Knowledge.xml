<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <KnowledgeFramework.KnowledgeDomainDef>
    <defName>RC_FieldGuide</defName>
    <stableId>reference.field-guide</stableId>
    <label>ReferenceConsumer_DomainLabel</label>
    <description>ReferenceConsumer_DomainDescription</description>
    <enableUncertainty>true</enableUncertainty>
    <enableFamiliarity>true</enableFamiliarity>
    <sharingModel>Reportable</sharingModel>
    <stageAggregationMode>Balanced</stageAggregationMode>
    <facets>
      <li>
        <defName>RC_ObservationFacet</defName>
        <stableId>observation</stableId>
        <label>ReferenceConsumer_FacetObservation</label>
        <description>ReferenceConsumer_FacetObservationDescription</description>
        <completenessAmount>100</completenessAmount>
        <shareable>true</shareable>
      </li>
      <li>
        <defName>RC_HabitatFacet</defName>
        <stableId>habitat</stableId>
        <label>ReferenceConsumer_FacetHabitat</label>
        <description>ReferenceConsumer_FacetHabitatDescription</description>
        <completenessAmount>100</completenessAmount>
        <shareable>true</shareable>
      </li>
    </facets>
    <claims>
      <li>
        <defName>RC_TemperatureClaim</defName>
        <domainId>reference.field-guide</domainId>
        <stableId>temperature</stableId>
        <facetId>observation</facetId>
        <valueType>Float</valueType>
        <revealedByDefault>true</revealedByDefault>
        <documentable>true</documentable>
      </li>
    </claims>
    <stages>
      <li>
        <defName>RC_EncounteredStage</defName>
        <label>ReferenceConsumer_StageEncountered</label>
        <description>ReferenceConsumer_StageEncounteredDescription</description>
        <order>0</order>
        <minimumKnowledge>0</minimumKnowledge>
      </li>
      <li>
        <defName>RC_StudiedStage</defName>
        <label>ReferenceConsumer_StageStudied</label>
        <description>ReferenceConsumer_StageStudiedDescription</description>
        <order>10</order>
        <minimumKnowledge>20</minimumKnowledge>
        <minimumConfidence>0.5</minimumConfidence>
      </li>
      <li>
        <defName>RC_DocumentedStage</defName>
        <label>ReferenceConsumer_StageDocumented</label>
        <description>ReferenceConsumer_StageDocumentedDescription</description>
        <order>20</order>
        <minimumKnowledge>40</minimumKnowledge>
        <minimumConfidence>0.7</minimumConfidence>
        <documented>true</documented>
      </li>
    </stages>
    <expertiseTracks>
      <li>
        <defName>RC_FieldcraftTrack</defName>
        <stableId>fieldcraft</stableId>
        <adept>10</adept>
        <expert>30</expert>
        <master>60</master>
      </li>
    </expertiseTracks>
    <observations>
      <li>
        <defName>RC_FieldObservation</defName>
        <stableId>field-observation</stableId>
        <baseKnowledge>12</baseKnowledge>
        <baseExpertise>4</baseExpertise>
        <shareable>true</shareable>
        <facetIds>
          <li>observation</li>
        </facetIds>
        <successOutcomes>
          <li>
            <facetId>observation</facetId>
            <knowledge>12</knowledge>
            <evidenceWeight>1</evidenceWeight>
            <confidenceFactor>1</confidenceFactor>
          </li>
        </successOutcomes>
      </li>
    </observations>
    <effects>
      <li>
        <defName>RC_FieldGuideEffect</defName>
        <domainId>reference.field-guide</domainId>
        <channelId>reference.field-guide.insight</channelId>
        <facetId>observation</facetId>
        <composition>Add</composition>
        <value>0.25</value>
        <priority>0</priority>
        <minimumKnowledge>1</minimumKnowledge>
        <resultId>reference-field-guide-effect</resultId>
      </li>
    </effects>
    <milestoneTracks>
      <li>
        <defName>RC_FieldGuideMilestones</defName>
        <domainId>reference.field-guide</domainId>
        <stableId>field-guide</stableId>
        <milestones>
          <li>
            <stableId>documented</stableId>
            <label>ReferenceConsumer_MilestoneDocumented</label>
            <description>ReferenceConsumer_MilestoneDocumentedDescription</description>
            <order>0</order>
            <permanent>true</permanent>
          </li>
        </milestones>
      </li>
    </milestoneTracks>
    <expertiseNamespaces>
      <li>
        <defName>RC_FieldGuideExpertise</defName>
        <stableId>reference.field-guide</stableId>
        <adept>10</adept>
        <expert>30</expert>
        <master>60</master>
      </li>
    </expertiseNamespaces>
  </KnowledgeFramework.KnowledgeDomainDef>

  <KnowledgeFramework.KnowledgeSubjectDef>
    <defName>RC_ReferenceSpecimen</defName>
    <domainId>reference.field-guide</domainId>
    <stableId>reference-specimen</stableId>
    <label>ReferenceConsumer_SubjectReference</label>
    <description>ReferenceConsumer_SubjectReferenceDescription</description>
    <applicableFacetIds>
      <li>observation</li>
      <li>habitat</li>
    </applicableFacetIds>
    <applicableClaimIds>
      <li>temperature</li>
    </applicableClaimIds>
  </KnowledgeFramework.KnowledgeSubjectDef>

  <KnowledgeFramework.KnowledgeContextTypeDef>
    <defName>RC_RegionContext</defName>
    <stableId>reference.region</stableId>
    <allowFallback>false</allowFallback>
  </KnowledgeFramework.KnowledgeContextTypeDef>

  <KnowledgeFramework.KnowledgeSubjectRelationTypeDef>
    <defName>RC_ObservedFromRelation</defName>
    <stableId>reference.observed-from</stableId>
    <parentage>false</parentage>
    <symmetric>false</symmetric>
    <metadataLimit>4</metadataLimit>
  </KnowledgeFramework.KnowledgeSubjectRelationTypeDef>
</Defs>
