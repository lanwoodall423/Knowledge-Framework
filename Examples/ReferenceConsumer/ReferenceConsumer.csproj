<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RootNamespace>ReferenceConsumer</RootNamespace>
    <AssemblyName>ReferenceConsumer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory).artifacts/</OutputPath>
    <ReferenceConsumerRimWorldManagedPath Condition="'$(ReferenceConsumerRimWorldManagedPath)' == ''">$(RimWorldManagedPath)</ReferenceConsumerRimWorldManagedPath>
    <ReferenceConsumerRimWorldManagedPath Condition="'$(ReferenceConsumerRimWorldManagedPath)' == ''">$(RIMWORLD_GAME_ROOT)</ReferenceConsumerRimWorldManagedPath>
    <ReferenceConsumerRimWorldManagedPath Condition="'$(ReferenceConsumerRimWorldManagedPath)' == ''">$(RIMWORLD_MANAGED_ASSEMBLIES)</ReferenceConsumerRimWorldManagedPath>
    <ReferenceConsumerKnowledgeFrameworkAssemblyPath Condition="'$(ReferenceConsumerKnowledgeFrameworkAssemblyPath)' == ''">$(KnowledgeFrameworkAssemblyPath)</ReferenceConsumerKnowledgeFrameworkAssemblyPath>
    <ReferenceConsumerKnowledgeFrameworkAssemblyPath Condition="'$(ReferenceConsumerKnowledgeFrameworkAssemblyPath)' == ''">$(KNOWLEDGEFRAMEWORK_ASSEMBLY_PATH)</ReferenceConsumerKnowledgeFrameworkAssemblyPath>
    <ReferenceConsumerKnowledgeFrameworkAssemblyPath Condition="'$(ReferenceConsumerKnowledgeFrameworkAssemblyPath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../1.7/Assemblies/KnowledgeFramework.dll'))</ReferenceConsumerKnowledgeFrameworkAssemblyPath>
    <ReferenceConsumerAssemblyCSharpPath>$([System.IO.Path]::Combine('$(ReferenceConsumerRimWorldManagedPath)', 'Assembly-CSharp.dll'))</ReferenceConsumerAssemblyCSharpPath>
    <ReferenceConsumerUnityStubsPath>$([System.IO.Path]::Combine('$(ReferenceConsumerRimWorldManagedPath)', 'UnityStubs.dll'))</ReferenceConsumerUnityStubsPath>
    <ReferenceConsumerWaylithPath>$([System.IO.Path]::Combine('$(ReferenceConsumerRimWorldManagedPath)', 'Waylith.dll'))</ReferenceConsumerWaylithPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="KnowledgeFramework"><HintPath>$(ReferenceConsumerKnowledgeFrameworkAssemblyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ReferenceConsumerAssemblyCSharpPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(ReferenceConsumerUnityStubsPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(ReferenceConsumerWaylithPath)</HintPath><Private>false</Private></Reference>
    </ItemGroup>
  <Target Name="ValidateReferenceConsumerDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ReferenceConsumerUnityStubsPath)')" Text="RimWorld 1.7 UnityStubs.dll not found at game root." />
    <Error Condition="!Exists('$(ReferenceConsumerWaylithPath)')" Text="RimWorld 1.7 Waylith.dll not found at game root." />
    <Error Condition="'$(ReferenceConsumerRimWorldManagedPath)' == ''" Text="Reference Consumer build blocked: set ReferenceConsumerRimWorldManagedPath or RIMWORLD_GAME_ROOT to a local RimWorld 1.7 installation root." />
    <Error Condition="'$(ReferenceConsumerKnowledgeFrameworkAssemblyPath)' == ''" Text="Reference Consumer build blocked: set ReferenceConsumerKnowledgeFrameworkAssemblyPath or KNOWLEDGEFRAMEWORK_ASSEMBLY_PATH to KnowledgeFramework.dll." />
    <Error Condition="!Exists('$(ReferenceConsumerKnowledgeFrameworkAssemblyPath)')" Text="Reference Consumer build blocked: missing KnowledgeFramework.dll at '$(ReferenceConsumerKnowledgeFrameworkAssemblyPath)'." />
    <Error Condition="!Exists('$(ReferenceConsumerAssemblyCSharpPath)')" Text="Reference Consumer build blocked: missing Assembly-CSharp.dll at '$(ReferenceConsumerAssemblyCSharpPath)'. Supply a legitimate local RimWorld 1.7 installation root; no assemblies are downloaded." />
  </Target>
</Project>
