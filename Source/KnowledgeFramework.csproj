<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RootNamespace>KnowledgeFramework</RootNamespace>
    <AssemblyName>KnowledgeFramework</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildThisFileDirectory)=/_/KnowledgeFramework/</PathMap>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Description>General-purpose epistemic gameplay framework for RimWorld.</Description>
    <KnowledgeFrameworkRimWorldManagedPath Condition="'$(KnowledgeFrameworkRimWorldManagedPath)' == ''">$(RimWorldManagedPath)</KnowledgeFrameworkRimWorldManagedPath>
    <KnowledgeFrameworkRimWorldManagedPath Condition="'$(KnowledgeFrameworkRimWorldManagedPath)' == ''">$(RIMWORLD_GAME_ROOT)</KnowledgeFrameworkRimWorldManagedPath>
    <KnowledgeFrameworkRimWorldManagedPath Condition="'$(KnowledgeFrameworkRimWorldManagedPath)' == ''">$(RIMWORLD_MANAGED_ASSEMBLIES)</KnowledgeFrameworkRimWorldManagedPath>
    <KnowledgeFrameworkHarmonyPath Condition="'$(KnowledgeFrameworkHarmonyPath)' == ''">$(HarmonyPath)</KnowledgeFrameworkHarmonyPath>
    <KnowledgeFrameworkHarmonyPath Condition="'$(KnowledgeFrameworkHarmonyPath)' == ''">$(RIMWORLD_HARMONY_PATH)</KnowledgeFrameworkHarmonyPath>
    <KnowledgeFrameworkHarmonyAssemblyPath Condition="'$(KnowledgeFrameworkHarmonyAssemblyPath)' == ''">$(HarmonyAssemblyPath)</KnowledgeFrameworkHarmonyAssemblyPath>
    <KnowledgeFrameworkHarmonyAssemblyPath Condition="'$(KnowledgeFrameworkHarmonyAssemblyPath)' == ''">$(RIMWORLD_HARMONY_ASSEMBLY)</KnowledgeFrameworkHarmonyAssemblyPath>
    <KnowledgeFrameworkHarmonyAssemblyPath Condition="'$(KnowledgeFrameworkHarmonyAssemblyPath)' == '' and '$(KnowledgeFrameworkHarmonyPath)' != ''">$([System.IO.Path]::Combine('$(KnowledgeFrameworkHarmonyPath)', '0Harmony.dll'))</KnowledgeFrameworkHarmonyAssemblyPath>
    <KnowledgeFrameworkAssemblyCSharpPath>$([System.IO.Path]::Combine('$(KnowledgeFrameworkRimWorldManagedPath)', 'Assembly-CSharp.dll'))</KnowledgeFrameworkAssemblyCSharpPath>
    <KnowledgeFrameworkUnityStubsPath>$([System.IO.Path]::Combine('$(KnowledgeFrameworkRimWorldManagedPath)', 'UnityStubs.dll'))</KnowledgeFrameworkUnityStubsPath>
    <KnowledgeFrameworkWaylithPath>$([System.IO.Path]::Combine('$(KnowledgeFrameworkRimWorldManagedPath)', 'Waylith.dll'))</KnowledgeFrameworkWaylithPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize><OutputPath>$(MSBuildThisFileDirectory)../1.7/Assemblies/</OutputPath><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(KnowledgeFrameworkAssemblyCSharpPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(KnowledgeFrameworkUnityStubsPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(KnowledgeFrameworkWaylithPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(KnowledgeFrameworkHarmonyAssemblyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateKnowledgeFrameworkDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(KnowledgeFrameworkUnityStubsPath)')" Text="RimWorld 1.7 UnityStubs.dll not found at game root." />
    <Error Condition="!Exists('$(KnowledgeFrameworkWaylithPath)')" Text="RimWorld 1.7 Waylith.dll not found at game root." />
    <Error Condition="'$(KnowledgeFrameworkRimWorldManagedPath)' == ''" Text="Knowledge Framework build blocked: set KnowledgeFrameworkRimWorldManagedPath or RIMWORLD_GAME_ROOT to a local RimWorld 1.7 installation root." />
    <Error Condition="'$(KnowledgeFrameworkHarmonyAssemblyPath)' == ''" Text="Knowledge Framework build blocked: set KnowledgeFrameworkHarmonyAssemblyPath or RIMWORLD_HARMONY_ASSEMBLY, or set KnowledgeFrameworkHarmonyPath/RIMWORLD_HARMONY_PATH to a directory containing 0Harmony.dll." />
    <Error Condition="!Exists('$(KnowledgeFrameworkAssemblyCSharpPath)')" Text="Knowledge Framework build blocked: missing Assembly-CSharp.dll at '$(KnowledgeFrameworkAssemblyCSharpPath)'. Supply a legitimate local RimWorld 1.7 installation root; no assemblies are downloaded." />
    <Error Condition="!Exists('$(KnowledgeFrameworkHarmonyAssemblyPath)')" Text="Knowledge Framework build blocked: missing 0Harmony.dll at '$(KnowledgeFrameworkHarmonyAssemblyPath)'. Supply a legitimate local Harmony assembly; no assembly is downloaded." />
  </Target>
</Project>
