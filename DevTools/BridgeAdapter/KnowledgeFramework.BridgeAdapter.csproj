<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RootNamespace>KnowledgeFrameworkBridgeAdapter</RootNamespace>
    <AssemblyName>KnowledgeFramework.BridgeAdapter</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <KnowledgeFrameworkRimWorldManagedPath Condition="'$(KnowledgeFrameworkRimWorldManagedPath)' == ''">$(RimWorldManagedPath)</KnowledgeFrameworkRimWorldManagedPath>
    <KnowledgeFrameworkRimWorldManagedPath Condition="'$(KnowledgeFrameworkRimWorldManagedPath)' == ''">$(RIMWORLD_GAME_ROOT)</KnowledgeFrameworkRimWorldManagedPath>
    <KnowledgeFrameworkRimWorldManagedPath Condition="'$(KnowledgeFrameworkRimWorldManagedPath)' == ''">$(RIMWORLD_MANAGED_ASSEMBLIES)</KnowledgeFrameworkRimWorldManagedPath>
    <KnowledgeFrameworkPrimaryAssemblyPath Condition="'$(KnowledgeFrameworkPrimaryAssemblyPath)' == ''">$(KnowledgeFrameworkAssemblyPath)</KnowledgeFrameworkPrimaryAssemblyPath>
    <KnowledgeFrameworkPrimaryAssemblyPath Condition="'$(KnowledgeFrameworkPrimaryAssemblyPath)' == ''">$(KNOWLEDGEFRAMEWORK_ASSEMBLY_PATH)</KnowledgeFrameworkPrimaryAssemblyPath>
    <KnowledgeFrameworkPrimaryAssemblyPath Condition="'$(KnowledgeFrameworkPrimaryAssemblyPath)' == ''">$(MSBuildThisFileDirectory)../../1.7/Assemblies/KnowledgeFramework.dll</KnowledgeFrameworkPrimaryAssemblyPath>
    <KnowledgeFrameworkAdapterAssemblyCSharpPath>$([System.IO.Path]::Combine('$(KnowledgeFrameworkRimWorldManagedPath)', 'Assembly-CSharp.dll'))</KnowledgeFrameworkAdapterAssemblyCSharpPath>
    <KnowledgeFrameworkAdapterUnityStubsPath>$([System.IO.Path]::Combine('$(KnowledgeFrameworkRimWorldManagedPath)', 'UnityStubs.dll'))</KnowledgeFrameworkAdapterUnityStubsPath>
    <KnowledgeFrameworkAdapterWaylithPath>$([System.IO.Path]::Combine('$(KnowledgeFrameworkRimWorldManagedPath)', 'Waylith.dll'))</KnowledgeFrameworkAdapterWaylithPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
        <HintPath>$(KnowledgeFrameworkAdapterAssemblyCSharpPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs"><HintPath>$(KnowledgeFrameworkAdapterUnityStubsPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(KnowledgeFrameworkAdapterWaylithPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="KnowledgeFramework">
      <HintPath>$(KnowledgeFrameworkPrimaryAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateKnowledgeFrameworkBridgeDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(KnowledgeFrameworkAdapterUnityStubsPath)')" Text="RimWorld 1.7 UnityStubs.dll not found at game root." />
    <Error Condition="!Exists('$(KnowledgeFrameworkAdapterWaylithPath)')" Text="RimWorld 1.7 Waylith.dll not found at game root." />
    <Error Condition="'$(KnowledgeFrameworkRimWorldManagedPath)' == ''" Text="Bridge adapter build blocked: set KnowledgeFrameworkRimWorldManagedPath or RIMWORLD_GAME_ROOT to a local RimWorld 1.7 installation root." />
    <Error Condition="!Exists('$(KnowledgeFrameworkAdapterAssemblyCSharpPath)')" Text="Bridge adapter build blocked: missing Assembly-CSharp.dll at '$(KnowledgeFrameworkAdapterAssemblyCSharpPath)'. No proprietary assemblies are downloaded." />
    <Error Condition="!Exists('$(KnowledgeFrameworkPrimaryAssemblyPath)')" Text="Bridge adapter build blocked: missing KnowledgeFramework.dll at '$(KnowledgeFrameworkPrimaryAssemblyPath)'. Build the primary framework first or set KnowledgeFrameworkPrimaryAssemblyPath/KNOWLEDGEFRAMEWORK_ASSEMBLY_PATH." />
  </Target>
</Project>
